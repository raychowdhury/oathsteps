# OathSteps environment. Copy to .env; never commit .env.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite file. Must be on durable storage in production (see docs/OPERATIONS.md).
DATABASE_URL=file:./data/oathsteps.db

# Development mail sink: verification/reset emails are written to this folder instead of being sent.
MAIL_SINK_DIR=./data/mail
# Production mail provider is not configured in this release; see docs/OPERATIONS.md.

# Conditional integrations. All disabled unless configured; see docs/INTEGRATIONS.md.
SPEECH_PROVIDER=disabled
USCIS_STATUS_PROVIDER=disabled
PAYMENTS_PROVIDER=disabled
PUSH_PROVIDER=disabled

# --- Production mail (docs/DEPLOY.md). Leave MAIL_PROVIDER empty in development: MAIL_SINK_DIR is used.
# MAIL_PROVIDER=brevo (free tier, no domain needed) or resend.
MAIL_PROVIDER=
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=

# --- Privacy notice and Terms pages
LEGAL_ENTITY=
LEGAL_CONTACT_EMAIL=
# A public contact page (for example a GitHub issues URL) used when no email is published.
LEGAL_CONTACT_URL=
LEGAL_JURISDICTION=
# Set to the date (YYYY-MM-DD) a lawyer signed off on the text. Until then both pages show "Draft".
LEGAL_REVIEWED_ON=
