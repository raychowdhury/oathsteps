<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Release builds are guest-only (no OATHSTEPS_API_BASE_URL), so nothing leaves the device.
	     When accounts are switched on, declare EmailAddress, Name and OtherUserContent here
	     (linked, not tracking, app functionality) and update the App Privacy answers. See ios/README.md. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
